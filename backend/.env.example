# FastAPI Application Environment Configuration
ENVIRONMENT=production
DEBUG=false
APP_NAME="Smart Plastic Waste Collection Optimization Platform"
API_V1_PREFIX=/api

# Database Connection (SQLite default, or PostgreSQL for cloud deployment)
# DATABASE_URL=postgresql://user:password@localhost:5432/ecoroute_db
DATABASE_URL=sqlite:///./ecoroute.db

# JWT Security
SECRET_KEY=generate_a_secure_random_64_character_hex_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80","https://yourdomain.com"]

# OSRM Routing Engine Endpoint
OSRM_SERVER_URL=http://router.project-osrm.org

# File Upload Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
